{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seseri-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Sync blobs. D1 rather than KV for two reasons: KV's free-tier ceiling is
  // 1000 writes/day across the whole account, below a single heavy listening
  // day; and KV is eventually consistent, so a push on the PC followed by a
  // pull on the phone could hand back the previous blob.
  //
  // Local dev and the vitest pool ignore database_id and create their own copy;
  // only a deploy and `--remote` migrations touch the one named here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seseri-sync",
      "database_id": "7bb991eb-c0c4-47d5-9717-5f05ef594c15",
      "migrations_dir": "migrations"
    }
  ],
  // Every budget lives on the platform limiter. The KV counter these replaced
  // spent a write per request out of 1000/day for the whole account and then
  // failed open for everyone, on every route, until the quota reset.
  "ratelimits": [
    { "name": "SYNC_IP", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "SYNC_ID", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "PROXY_IP", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["17 4 * * *"] }
}
